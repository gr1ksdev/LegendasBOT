# ==============================================================================
# CONFIGURAÇÕES DO TELEGRAM BOT & API
# ==============================================================================
TELEGRAM_BOT_TOKEN=

# ID do proprietário/administrador principal do Bot
OWNER_ID=

# ==============================================================================
# BANCO DE DADOS & CACHE
# ==============================================================================
# APP_ENV: 'dev' para SQLite local, 'prod' para PostgreSQL
APP_ENV=dev
DATABASE_FILE=database.db
REDIS_HOST=localhost:6379

# Configurações do PostgreSQL (usado quando APP_ENV=prod)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=freddybot

# ==============================================================================
# SEGURANÇA, CRIPTOGRAFIA & AUTH (JWT / AES-256)
# ==============================================================================
# Chave secreta principal usada para assinatura de JWT e derivação da criptografia dos Rascunhos (AES-256)
# Deve ser uma string forte (mínimo 32 caracteres)
SECRET_KEY=exemplo_chave_secreta_minimo_32_caracteres_12345

# Chave opcional de criptografia de dados em repouso
ENCRYPTION_KEY=

# Segredo exclusivo do webhook do Telegram (1-256 caracteres: A-Z, a-z, 0-9, _ ou -)
TELEGRAM_WEBHOOK_SECRET=example_webhook_secret_change_me_2026

JWT_ISSUER=t.me/legendasbrbot

# ==============================================================================
# SERVIDOR HTTP & PAINEL DASHBOARD
# ==============================================================================
APP_PORT=7000
GIN_MODE=release
WEBAPP_URL=
WEBHOOK_URL=
CORS_ALLOW_ORIGINS=

# ==============================================================================
# MODO DE TESTE TELEGRAM STARS (OPCIONAL)
# ==============================================================================
# STARS_TEST_MODE=true ativa invoices de teste (1 Star). Desativado automaticamente em prod.
STARS_TEST_MODE=false

# ==============================================================================
# MTPROTO / CONTAS CONECTADAS (OPCIONAL)
# Obtenha suas credenciais em https://my.telegram.org/apps
# ==============================================================================
MTPROTO_APP_ID=
MTPROTO_APP_HASH=
